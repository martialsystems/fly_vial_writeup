{
  "runtime_checks": [
    {
      "id": "unit-tests",
      "argv": [".venv/bin/python", "-m", "pytest", "tests/", "-q"],
      "timeout_s": 120,
      "paths": [
        "NOTE.md",
        "README.md",
        "AGENTS.md",
        "description.txt",
        "tests/**",
        "scripts/**",
        "docs/**",
        "pyproject.toml",
        "vbd.runtime.json"
      ]
    }
  ]
}
